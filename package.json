{
  "name": "ganomabi-asset-studio",
  "version": "1.11.0",
  "description": "DITASHA Editor \u2014 editor tekstur YTD dan preview model YDD",
  "author": "Ditasha-Workshop",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run build:ui && electron-builder --win portable --x64",
    "test": "node --test tests/updater.test.cjs tests/updater.windows.test.cjs tests/ipc-trust.test.cjs tests/format.test.mjs tests/ui-updates.test.cjs tests/asset-tools.test.mjs tests/archives.test.mjs tests/viewer-format.test.mjs tests/ped-attachments.test.mjs tests/update-startup.test.cjs tests/material-preview.test.mjs tests/vehicle-preview.test.mjs",
    "build:ui": "esbuild src/app.js --bundle --minify --outfile=ui/app.js",
    "prestart": "npm run build:ui",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "com.ganomabi.assetstudio",
    "productName": "DITASHA-Editor",
    "copyright": "Copyright \u00a9 2026 Ditasha-Workshop",
    "files": [
      "electron/**/*.cjs",
      "ui/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "DITASHA-Editor.exe",
      "useZip": true
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "pako": "3.0.2",
    "three": "0.186.1"
  }
}
