{
  "name": "ganomabi-asset-studio",
  "version": "1.3.3",
  "description": "DITASHA Editor \u2014 editor tekstur YTD dan preview model YDD",
  "author": "Ditasha-Workshop",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run build:ui && electron-builder --win portable --x64",
    "test": "node --test updater.test.cjs updater.windows.test.cjs ipc-trust.test.cjs format.test.mjs",
    "build:ui": "esbuild src/app.js --bundle --minify --outfile=ui/app.js",
    "prestart": "npm run build:ui"
  },
  "build": {
    "appId": "com.ganomabi.assetstudio",
    "productName": "DITASHA-Editor",
    "copyright": "Copyright \u00a9 2026 Ditasha-Workshop",
    "files": [
      "main.cjs",
      "ui/**/*",
      "icon.ico",
      "package.json",
      "preload.cjs",
      "updater.cjs",
      "ipc-trust.cjs",
      "installer.cjs",
      "update-probe.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "DITASHA-Editor.exe",
      "useZip": true
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "pako": "3.0.2",
    "three": "0.186.1"
  }
}
