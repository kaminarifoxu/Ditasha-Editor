{
  "name": "ganomabi-asset-studio",
  "version": "1.19.1",
  "description": "DITASHA Editor — editor tekstur YTD dan preview model YDD",
  "author": "Ditasha-Workshop",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run prepare:ide && npm run build:ui && electron-builder --win portable --x64",
    "prepare:ide": "node scripts/prepare-ide.cjs",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "build:ui": "node scripts/build-ui.cjs",
    "prestart": "npm run build:ui",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "com.ganomabi.assetstudio",
    "productName": "DITASHA-Editor",
    "copyright": "Copyright © 2026 Ditasha-Workshop",
    "files": [
      "electron/**/*.cjs",
      "ui/**/*",
      "assets/icon.ico",
      "package.json",
      "electron/**/*.py"
    ],
    "extraResources": [
      {
        "from": "ide-runtime",
        "to": "ide-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "ide-runtime/node_modules",
        "to": "ide-runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "DITASHA-Editor.exe",
      "useZip": true
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "pako": "3.0.2",
    "tex-decoder": "2.0.0",
    "three": "0.186.1"
  },
  "discordApplicationId": ""
}
