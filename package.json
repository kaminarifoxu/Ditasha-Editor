{
  "name": "ganomabi-asset-studio",
  "version": "1.1.0",
  "description": "Editor tekstur YTD dan penampil model YDD GANOMABI",
  "author": "GANOMABI / amiinarii",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "test": "node --test updater.test.cjs"
  },
  "build": {
    "appId": "com.ganomabi.assetstudio",
    "productName": "GANOMABI Asset Studio",
    "copyright": "Copyright \u00a9 2026 GANOMABI / amiinarii",
    "files": [
      "main.cjs",
      "ui/**/*",
      "icon.ico",
      "package.json",
      "preload.cjs",
      "updater.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "GANOMABI-Asset-Studio-${version}-Windows-x64.exe",
      "useZip": true
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
